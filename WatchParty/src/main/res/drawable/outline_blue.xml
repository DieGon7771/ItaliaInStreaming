<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#333B65F5" />
            <stroke
                android:width="2dp"
                android:color="#FF7C93FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#223B65F5" />
            <stroke
                android:width="2dp"
                android:color="#CC7C93FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#143B65F5" />
            <stroke
                android:width="2dp"
                android:color="#997C93FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
